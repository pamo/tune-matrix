SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Last.fm: universal best-effort provider (works for any service you scrobble).
# API key from https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key
LASTFM_USER=your_lastfm_username

# Optional override for --provider youtube-music
YTMUSIC_AUTH_HEADERS_PATH=.cache/ytmusic_auth.json
